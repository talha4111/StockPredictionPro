# Copy this file to .env and fill values locally.
# Never commit .env.

# Remote server access for deploy/diagnose scripts
REMOTE_HOST=
REMOTE_USER=
REMOTE_PORT=22
REMOTE_PASSWORD=
# Prefer SSH keys over passwords when possible:
# REMOTE_KEY_FILE=C:\path\to\private-key.pem

# Binance live futures
LIVE_API_KEY=
LIVE_SECRET_KEY=

# Binance demo/testnet
TESTNET_API_KEY=
TESTNET_SECRET=
DEMO_CALISMA_PROFILI=LIVE_SHADOW
SHORT_ISLEM_AKTIF=false
MIN_SCOUT_QUOTE_VOLUME_USDT=15000000
MAX_SCOUT_COIN_SAYISI=100
TEK_DONGU_TANI_MODU=false
TANI_MAX_COIN_SAYISI=20
MODEL_KALITE_KAPISI_AKTIF=true
MODEL_KALITE_BILINMEYENI_ENGELLE=true
MIN_MODEL_WALK_FORWARD_SKORU=0.50
MODEL_KALITE_SARI_ESIK=0.55
MODEL_KALITE_SARI_MARGIN_CARPANI=0.50
# Other option: KESIF

# AI analyst
GEMINI_API_KEY=

# SEC EDGAR historical fundamentals (company/name plus contact email)
SEC_USER_AGENT=StockPredictionPro YourEmail@example.com

# Monthly stock-scanner baseline/challenger paper comparison (no orders)
STOCK_SHADOW_PAPER=1
STOCK_OUTCOME_TRACKING=1
STOCK_SCAN_REPORT=1
STOCK_TELEGRAM_BULLETIN=1

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
